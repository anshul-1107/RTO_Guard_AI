# Paste this (with real values) into Streamlit Cloud -> App settings -> Secrets
DATABASE_URL = "postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
GEMINI_API_KEY = "..."
LLM_PROVIDER = "gemini"
EMBEDDINGS_PROVIDER = "gemini"
GEMINI_LLM_MODEL = "gemini-3.5-flash"
GEMINI_FALLBACK_MODEL = "gemini-3.1-flash-lite"
# optional tracing
LANGFUSE_PUBLIC_KEY = ""
LANGFUSE_SECRET_KEY = ""
