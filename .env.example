# Postgres (matches docker-compose)
POSTGRES_USER=rto
POSTGRES_PASSWORD=rto_pass
POSTGRES_DB=rto_guard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Data generation
DATA_SEED=42
N_CUSTOMERS=20000
N_ORDERS=100000

# Supabase: Project Settings -> Database -> Connection string (URI, session pooler)
# If set, this overrides the POSTGRES_* values above.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# gemini | fake  (fake = offline hashing embeddings for tests/dev, no API key needed)
EMBEDDINGS_PROVIDER=gemini

# Agent LLM
LLM_PROVIDER=gemini
GEMINI_LLM_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# USD per 1M tokens (update from ai.google.dev/pricing)
LLM_PRICE_IN_PER_M=0.50
LLM_PRICE_OUT_PER_M=3.00

# Langfuse tracing (optional, free at cloud.langfuse.com). Empty = disabled.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

BRAND_NAME=Kavya Threads
SALE_ACTIVE=false
